{
  "name": "showdown-referee-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Call it. – Showdown Rules Quiz for referees",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",

{
  "name": "showdown-referee-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Call it. \u2013 Showdown Rules Quiz for referees",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}

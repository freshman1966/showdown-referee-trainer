{
  "name": "Call it. – design tokens v0.1",
  "font": {
    "family": "'Atkinson Hyperlegible Next', system-ui, sans-serif",
    "familyMono": "'Atkinson Hyperlegible Mono', ui-monospace, monospace",
    "source": "Google Fonts (OFL). Self-host the woff2 files in the build; no runtime request to Google.",
    "weights": { "regular": 400, "bold": 700, "heavy": 800 },
    "size": { "min": 16, "small": 15, "body": 18, "bodyLarge": 20, "h3": 20, "h2": 22, "h1Mobile": 30, "h1Desktop": 34, "score": 24, "scoreLarge": 40 },
    "lineHeight": { "body": 1.45, "heading": 1.15 }
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32 },
  "radius": { "control": 10, "card": 12 },
  "size": { "touchTargetMin": 48, "contentMaxWidth": 1080, "focusRing": 3, "focusOffset": 2 },
  "themes": {
    "light": {
      "ground": "#F6F5F1", "surface": "#FFFFFF", "surfaceDisabled": "#EDECE6",
      "ink": "#14181F", "muted": "#5B6270", "border": "#7D838D", "borderSubtle": "#C4C7CC",
      "header": "#14181F", "onHeader": "#F6F5F1", "onHeaderMuted": "#C9CDD3",
      "accent": "#C2410C", "onAccent": "#FFFFFF", "headerAccent": "#FDBA74",
      "primaryButton": "#14181F", "onPrimaryButton": "#FFFFFF",
      "correct": "#1D4ED8", "correctBg": "#EEF2FD",
      "incorrect": "#9A3412", "incorrectBg": "#FBEFEA",
      "focus": "#C2410C", "progressTrack": "#3A414C", "progressFill": "#FDBA74"
    },
    "dark": {
      "ground": "#11161D", "surface": "#1A2029", "surfaceDisabled": "#232A34",
      "ink": "#EDEDE8", "muted": "#A1A9B5", "border": "#A1A9B5", "borderSubtle": "#4A525E",
      "header": "#0B0F14", "onHeader": "#EDEDE8", "onHeaderMuted": "#A1A9B5",
      "accent": "#FDBA74", "onAccent": "#11161D", "headerAccent": "#FDBA74",
      "primaryButton": "#EDEDE8", "onPrimaryButton": "#11161D",
      "correct": "#93C5FD", "correctBg": "#16243A",
      "incorrect": "#FDA4AF", "incorrectBg": "#3A1D22",
      "focus": "#FDBA74", "progressTrack": "#3A414C", "progressFill": "#FDBA74"
    },
    "highContrast": {
      "ground": "#000000", "surface": "#000000", "surfaceDisabled": "#000000",
      "ink": "#FFFFFF", "muted": "#FFFFFF", "border": "#FFFFFF", "borderSubtle": "#FFFFFF",
      "header": "#000000", "onHeader": "#FFFFFF", "onHeaderMuted": "#FFFFFF",
      "accent": "#FFE600", "onAccent": "#000000", "headerAccent": "#FFE600",
      "primaryButton": "#FFE600", "onPrimaryButton": "#000000",
      "correct": "#FFFFFF", "correctBg": "#000000",
      "incorrect": "#FFFFFF", "incorrectBg": "#000000",
      "focus": "#FFE600", "progressTrack": "#FFFFFF", "progressFill": "#FFE600"
    }
  },
  "notes": [
    "Dark theme values for surface, correctBg, incorrectBg are not on the canvas yet; verify contrast (text >= 4.5:1, borders/focus >= 3:1) when implementing.",
    "High contrast: correct = solid 4 px border, incorrect = dashed 4 px border; the words carry the meaning."
  ]
}
